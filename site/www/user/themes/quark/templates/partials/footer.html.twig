<section id="footer" class="section footer-section">
    <section class="container {{ grid_size }}">
        {% if site.social %}
            <div class="bottom-bar" aria-label="Social links">
                <div class="bottom-bar__inner">
                    {% for s in site.social %}
                        <a class="bottom-bar__link" href="{{ s.url|e('html_attr') }}" target="_blank" rel="noopener noreferrer" title="{{ s.label|e }}" aria-label="{{ s.label|e }}">
                            {% if s.icon %}
                                <i class="{{ s.icon|e }}" aria-hidden="true"></i>
                            {% endif %}
                        </a>
                    {% endfor %}
                </div>
            </div>
            <div class="section-divider footer-divider" aria-hidden="true"></div>
        {% endif %}
        <div class="bottom-bar__contact" aria-label="Contact email">
            <span>Contact:</span>
            <a href="mailto:officialneedless@gmail.com">officialneedless@gmail.com</a>
        </div>
        <div class="bottom-bar__copyright" aria-hidden="false">Copyright (c) 2026 Needless</div>
    </section>
</section>
