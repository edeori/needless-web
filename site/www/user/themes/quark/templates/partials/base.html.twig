{% set body_classes = body_class(['header-fixed', 'header-animated', 'header-dark', 'header-transparent', 'sticky-footer']) %}
{% set grid_size = theme_var('grid-size') %}
{% set compress = theme_var('production-mode') ? '.min.css' : '.css' %}
{% set page_seo = page.header.seo ?? {} %}
{% set seo_config = site.seo ?? {} %}
{% set seo_title = page_seo.title ?? page.header.seo_title ?? page.title ?? seo_config.title ?? site.title %}
{% set seo_description = page_seo.description ?? page.header.seo_description ?? seo_config.description ?? '' %}
{% set seo_keywords = page_seo.keywords ?? page.header.seo_keywords ?? seo_config.keywords ?? '' %}
{% set seo_robots = page_seo.robots ?? page.header.robots ?? seo_config.robots ?? 'index,follow' %}
{% set seo_twitter_card = page_seo.twitter_card ?? seo_config.twitter_card ?? 'summary_large_image' %}
{% set seo_twitter_title = page_seo.twitter_title ?? seo_title %}
{% set seo_twitter_description = page_seo.twitter_description ?? seo_description %}
{% set seo_twitter_site = page_seo.twitter_site ?? seo_config.twitter_site ?? '' %}
{% set seo_twitter_creator = page_seo.twitter_creator ?? seo_config.twitter_creator ?? seo_twitter_site %}
{% set default_image_path = seo_config.image ?? 'theme://images/logo-center.png' %}
{% set seo_image_raw = page_seo.image ?? page.header.seo_image ?? default_image_path %}
{% set seo_twitter_image_raw = page_seo.twitter_image ?? seo_config.twitter_image ?? seo_image_raw %}
{% set seo_image = '' %}
{% if seo_image_raw %}
    {% set temp_image = seo_image_raw %}
    {% if temp_image starts with 'theme://' or temp_image starts with 'user://' %}
        {% set temp_image = url(temp_image) %}
    {% endif %}
    {% if temp_image starts with 'http' %}
        {% set seo_image = temp_image %}
    {% else %}
        {% set seo_image = grav.uri.baseUrl(true) ~ temp_image %}
    {% endif %}
{% endif %}
{% set seo_twitter_image = '' %}
{% if seo_twitter_image_raw %}
    {% set temp_twitter_image = seo_twitter_image_raw %}
    {% if temp_twitter_image starts with 'theme://' or temp_twitter_image starts with 'user://' %}
        {% set temp_twitter_image = url(temp_twitter_image) %}
    {% endif %}
    {% if temp_twitter_image starts with 'http' %}
        {% set seo_twitter_image = temp_twitter_image %}
    {% else %}
        {% set seo_twitter_image = grav.uri.baseUrl(true) ~ temp_twitter_image %}
    {% endif %}
{% endif %}
{% set seo_url = page.url(true, true) %}
{% set site_url = grav.config.system.custom_base_url ?: seo_url %}
{% set same_as_links = [] %}
{% if site.social %}
    {% for profile in site.social %}
        {% if profile.url %}
            {% set same_as_links = same_as_links|merge([profile.url]) %}
        {% endif %}
    {% endfor %}
{% endif %}
{% set musicgroup_data = {
    '@context': 'https://schema.org',
    '@type': 'MusicGroup',
    'name': site.title|default(seo_title),
    'description': seo_description ?: site.metadata.description,
    'url': site_url,
    'genre': site.structured_data.musicgroup.genre|default('Progressive Death Metal'),
    'foundingLocation': site.structured_data.musicgroup.founding_location|default('Hungary'),
    'foundingDate': site.structured_data.musicgroup.founding_date|default('2004')
} %}
{% if seo_image %}
    {% set musicgroup_data = musicgroup_data|merge({'image': seo_image}) %}
{% endif %}
{% if site.author.email %}
    {% set musicgroup_data = musicgroup_data|merge({'email': site.author.email}) %}
{% endif %}
{% if same_as_links %}
    {% set musicgroup_data = musicgroup_data|merge({'sameAs': same_as_links}) %}
{% endif %}
{% use 'blocks/base.html.twig' %}
<!DOCTYPE html>
<html lang="{{ grav.language.getActive ?: grav.config.site.default_lang }}">
<head>
{% block head deferred %}
    <meta charset="utf-8" />
    <title>{{ seo_title|e('html') }}</title>

    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% if seo_description %}
    <meta name="description" content="{{ seo_description|e('html_attr') }}">
    {% endif %}
    {% if seo_keywords %}
    <meta name="keywords" content="{{ seo_keywords|e('html_attr') }}">
    {% endif %}
    <meta name="robots" content="{{ seo_robots|e('html_attr') }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ seo_title|e('html_attr') }}">
    {% if seo_description %}
    <meta property="og:description" content="{{ seo_description|e('html_attr') }}">
    {% endif %}
    <meta property="og:url" content="{{ seo_url|e('html_attr') }}">
    {% if seo_image %}
    <meta property="og:image" content="{{ seo_image|e('html_attr') }}">
    <meta property="og:image:secure_url" content="{{ seo_image|replace({'http://':'https://'})|e('html_attr') }}">
    {% endif %}
    <meta name="twitter:card" content="{{ seo_twitter_card|e('html_attr') }}">
    <meta name="twitter:title" content="{{ seo_twitter_title|e('html_attr') }}">
    {% if seo_twitter_description %}
    <meta name="twitter:description" content="{{ seo_twitter_description|e('html_attr') }}">
    {% endif %}
    {% if seo_twitter_site %}
    <meta name="twitter:site" content="{{ seo_twitter_site|e('html_attr') }}">
    {% endif %}
    {% if seo_twitter_creator %}
    <meta name="twitter:creator" content="{{ seo_twitter_creator|e('html_attr') }}">
    {% endif %}
    {% if seo_twitter_image %}
    <meta name="twitter:image" content="{{ seo_twitter_image|e('html_attr') }}">
    {% endif %}
    {% include 'partials/metadata.html.twig' %}

    <link rel="icon" type="image/ico" href="{{ url('theme://images/favicon.ico') }}" />
    <link rel="canonical" href="{{ seo_url }}" />
    {% if musicgroup_data.name %}
    <script type="application/ld+json">{{ musicgroup_data|json_encode|raw }}</script>
    {% endif %}
{% endblock head %}

{% block stylesheets %}
    {% do assets.addCss('theme://css-compiled/spectre'~compress) %}
    {% if theme_var('spectre.exp') %}{% do assets.addCss('theme://css-compiled/spectre-exp'~compress) %}{% endif %}
    {% if theme_var('spectre.icons') %}{% do assets.addCss('theme://css-compiled/spectre-icons'~compress) %}{% endif %}
    {% do assets.addCss('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css') %}
    {% do assets.addCss('theme://css-compiled/theme'~compress) %}
    {% do assets.addCss('theme://css/custom.css') %}
    {% do assets.addCss('theme://css/line-awesome.min.css') %}
{% endblock %}

{% block javascripts %}
    {% do assets.addJs('jquery', 101) %}
    {% do assets.addJs('theme://js/jquery.treemenu.js', {group:'bottom'}) %}
    {% do assets.addJs('theme://js/site.js', {group:'bottom'}) %}
{% endblock %}

{% block assets deferred %}
    {{ assets.css()|raw }}
    {{ assets.js()|raw }}
{% endblock %}
</head>
<body id="top" class="{% block body_classes %}{{ body_classes }}{% endblock %}">
    <div id="page-wrapper">
    {% block header %}
        <section id="header" class="section">
            <section class="container {{ grid_size }}">
                <nav class="navbar">
                    <section class="navbar-section desktop-menu">

                        <nav class="dropmenu animated">
                        {% block header_navigation %}
                            {% include 'partials/navigation.html.twig' %}
                        {% endblock %}
                        </nav>

                        {% if config.plugins.login.enabled and grav.user.username %}
                            <span class="login-status-wrapper"><i class="fa fa-user"></i> {% include 'partials/login-status.html.twig' ignore missing %}</span>
                        {% endif %}

                    </section>
                </nav>
            </section>
        </section>
        <div class="mobile-menu">
            <div class="button_container" id="toggle">
                <span class="top"></span>
                <span class="middle"></span>
                <span class="bottom"></span>
            </div>
        </div>
    {% endblock %}

    {% block hero %}{% endblock %}

        <section id="start">
        {% block body %}
            <section id="body-wrapper" class="section">
                <section class="container {{ grid_size }}">
                    {% block messages %}
                        {% include 'partials/messages.html.twig' ignore missing %}
                    {% endblock %}
                    {{ block('content_surround') }}
                </section>
            </section>
        {% endblock %}
        </section>

    </div>

    {% block footer %}
        {% include 'partials/footer.html.twig' %}
    {% endblock %}

    {% block mobile %}
    <div class="mobile-container">
        <div class="overlay" id="overlay">
            <nav class="overlay-menu">
                {% include 'partials/navigation.html.twig' with {tree: true} %}
            </nav>
        </div>
    </div>
    {% endblock %}

{% block bottom %}
    {{ assets.js('bottom')|raw }}
{% endblock %}

</body>
</html>
